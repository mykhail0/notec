NASMFLAGS = -f elf64 -w+all -w+error -w-unknown-warning
CFLAGS = -lstdc++ -lpthread -Xlinker -z -Xlinker notext

ifndef binary
$(error binary is not set)
endif

all: ${binary}_test_1 ${binary}_test_2 ${binary}_test_3 ${binary}_test_${NNNN}

${binary}_test_%: ${binary}_student_%.o ${script_dir}/binary_%.o
	gcc $(CFLAGS) -o $@ $^

${binary}_student_%.o: ${source}
	nasm $(NASMFLAGS) -DN=$* -o $@ $^

.PRECIOUS: ${binary}_student_%.o

.PHONY: all clean

clean:
	rm -rf ${binary}* || echo "Not specified binary"
